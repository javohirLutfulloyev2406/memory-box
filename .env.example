# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=memorybox
POSTGRES_USER=memorybox
POSTGRES_PASSWORD=change-me
# Host port the db container publishes. Default 5433 (not 5432) to avoid colliding
# with a PostgreSQL install already running on this machine; change it back to 5432
# here if you don't have one and prefer the conventional port.
POSTGRES_PORT=5433

# --- Spring datasource (used by the app, whether run locally or via docker-compose) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/memorybox
DATABASE_USERNAME=memorybox
DATABASE_PASSWORD=change-me

# --- Development-only authentication ---
# When true, every request is authenticated as a single fixed dev user. Convenient
# before a real login flow exists. NEVER set this to true in a production deployment.
# Defaults to false; flip to true only in your own local .env.
DEV_AUTH_ENABLED=false

# --- Telegram bot integration (optional) ---
# Leave TELEGRAM_BOT_ENABLED=false (or TELEGRAM_BOT_TOKEN empty) to run without it.
# See README.md "Telegram bot setup" for how to obtain a token and register a webhook.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Background processing ---
METADATA_FETCH_ENABLED=true
PROCESSING_WORKER_ENABLED=true